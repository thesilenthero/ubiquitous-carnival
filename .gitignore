# The database holds the real job search — applications, salaries, contacts.
# Never commit it. Timestamped copies live in data/backups/.
data/
job_files/

# The hand-filed archive the backfill reads: resumes, postings, cover letters.
# Same reason as data/ — it is the job search itself, and it is 278MB of PDFs.
Archived Applications/

# Python
__pycache__/
*.pyc
.venv/
.streamlit/

# Node — at every level, not just web/
node_modules/

# Build output
web/dist/
web/tsconfig.tsbuildinfo

# macOS
.DS_Store

# Google service-account key for the Sheet mirror — a credential, never commit.
*service-account*.json
credentials/
.env

# Personal working documents — not source, and this repo is public.
documents/

# Generated by scripts/backfill_archive.py: a map of the real job search
# (company names, roles, dates) plus absolute paths into "Archived
# Applications". Reproducible, and nothing in the app reads it.
scripts/archive_map.json
